{
  "notetype_name": "Japanese Vocab Dynamic+",
  "fields": [
    "Expression",
    "Meaning",
    "Reading",
    "Audio",
    "Sentence",
    "Sentence-Kana",
    "Sentence-English",
    "Sentence Audio"
  ],
  "templates": [
    {
      "name": "Listening",
      "qfmt": "<div class=\"cardClr\">\n    <hr>\n    <div class=\"card\">\n        <div class=\"card\">\n            <div class=\"cardClr\">\n                Listen.<hr>\n                {{furigana:Sentence Audio}}\n                {{Audio}}\n            </div>\n        </div>\n    </div>\n</div>\n<div class=\"cardClr\">\n    <hr>\n</div>",
      "afmt": "<div class=\"cardClr\">\n    <div class=\"card\">\n        {{furigana:Sentence Audio}}<br>\n        <hr id=\"answer\">\n        {{furigana:Sentence}}\n        <br><br>\n        {{Sentence-English}}\n        <br>\n        {{Sentence-Kana}}\n        <hr>\n\n        <div class=\"cardClr\">\n            <span class=\"windows-link\"></span>\n            <span class=\"android-link\"></span>\n            <span class=\"mac-link\"></span>\n        </div>\n\n      <script>\n    var windowsLinkElement = document.querySelector(\".windows-link\");\n    var androidLinkElement = document.querySelector(\".android-link\");\n    var macLinkElement = document.querySelector(\".mac-link\");\n\n    function createLink(url, text) {\n        var link = document.createElement('a');\n        link.href = url;\n        link.textContent = text;\n        return link;\n    }\n\n    var expression = \"{{text:Expression}}\";\n    var websiteUrl = \"https://takoboto.jp/?q=\" + encodeURIComponent(expression);\n    var appUrl = \"intent:#Intent;package=jp.takoboto;action=jp.takoboto.SEARCH;S.q=\" + encodeURIComponent(expression) + \";end\";\n\n    if (window.navigator.userAgent.indexOf(\"Windows\") !== -1) {\n        windowsLinkElement.appendChild(createLink(websiteUrl, expression));\n    } else if (window.navigator.userAgent.indexOf(\"Mac\") !== -1) {\n        macLinkElement.appendChild(createLink(websiteUrl, expression));\n    } else if (window.navigator.userAgent.indexOf(\"Android\") !== -1) {\n        androidLinkElement.appendChild(createLink(appUrl, expression));\n    } else {\n        windowsLinkElement.appendChild(createLink(websiteUrl, expression));\n    }\n</script>\n\n        <div class=\"card\">\n            {{furigana:Reading}}\n            <br>\n            <div class=\"cardClr\">\n                <span class=\"link\"></span>\n            </div>\n\t\t\t\t\t\t\n           <a href=\"https://takoboto.jp/?q={{Meaning}}\">{{Meaning}}</a>\n\n            <br><br>\n            {{Audio}}\n            <hr><hr>\n        </div>\n    </div>\n</div>"
    },
    {
      "name": "Reading",
      "qfmt": "<div class=\"card\">\n    <br>\n    {{furigana:Sentence}}\n    <br>\n    <hr>\n    {{furigana:Expression}}\n    <br>\n    <br>\n</div>",
      "afmt": "<div class=\"cardClr\">\n    <div class=\"card\">\n        {{furigana:Sentence Audio}}<br>\n        <hr id=\"answer\">\n        {{furigana:Sentence}}\n        <br><br>\n        {{Sentence-English}}\n        <br>\n        {{Sentence-Kana}}\n        <hr>\n\n        <div class=\"cardClr\">\n            <span class=\"windows-link\"></span>\n            <span class=\"android-link\"></span>\n            <span class=\"mac-link\"></span>\n        </div>\n\n        <script>\n            var windowsLinkElement = document.querySelector(\".windows-link\");\n            var androidLinkElement = document.querySelector(\".android-link\");\n            var macLinkElement = document.querySelector(\".mac-link\");\n\n            function createLink(url, text) {\n                var link = document.createElement('a');\n                link.href = url;\n                link.textContent = text;\n                return link;\n            }\n\n            var expression = \"{{text:Expression}}\";\n            var websiteUrl = \"https://takoboto.jp/?q=\" + encodeURIComponent(expression);\n            var appUrl = \"intent:#Intent;package=jp.takoboto;action=jp.takoboto.SEARCH;S.q=\" + encodeURIComponent(expression) + \";end\";\n\n            if (window.navigator.userAgent.indexOf(\"Windows\") !== -1) {\n                windowsLinkElement.appendChild(createLink(websiteUrl, expression));\n            } else if (window.navigator.userAgent.indexOf(\"Mac\") !== -1) {\n                macLinkElement.appendChild(createLink(websiteUrl, expression));\n            } else if (window.navigator.userAgent.indexOf(\"Android\") !== -1) {\n                androidLinkElement.appendChild(createLink(appUrl, expression));\n            } else {\n                windowsLinkElement.appendChild(createLink(websiteUrl, expression));\n            }\n        </script>\n\n        <div class=\"card\">\n            {{furigana:Reading}}\n            <br>\n            <div class=\"cardClr\">\n                <span class=\"link\"></span>\n            </div>\n            \n            <a href=\"https://takoboto.jp/?q={{text:Meaning}}\">{{text:Meaning}}</a>\n\n            <br><br>\n            {{Audio}}\n            <hr><hr>\n        </div>\n    </div>\n</div>"
    }
  ],
  "css": ".mobile.night_mode { \n\n background-color: white; \n\n -webkit-filter: invert(100%); \n   filter: invert(100%); \n}\n.mobile .cardClr {\n\tfont-size: 32px;\n}\n.mobile .card {\n\tpadding: 0px 0px;\n \tfont-size: 26px;\n\tmax-width: 9000px;\n}\n\n@font-face {\n  font-family: myfont;\n  src: url(\"_mplus-2c-light.ttf\");\n}\n\nhr {\n    height: 2px;\n    background-color: #4c4640;\n    border: 0;\n}\n\na {\n\tcolor: #749481;\n\ttext-decoration: none;\n}\n\n.cardClr {\n font-size: 40px;\n color: #ab997e;\n text-align: center;\n}\n.card {\n\tpadding: 10px 0px;\n\tmax-width: 1200px; /* CHANGE CARD SIZE HERE */\n\tmargin: 0 auto; /* CENTERS THE CARD IN THE MIDDLE OF THE WINDOW */\n\tword-wrap: break-word; /* BREAKS UP LONG WORKS */\n font-family: myfont;\n font-size: 30px;\n Color: #ab997e;\n text-align: center;\n}\n\n#extra {\n\tcolor: #EBEBEB;\n}\n#kard {\n    padding: 0px 0px;\n    max-width: 400px; /* CHANGE CARD SIZE HERE */\n    margin: 0 auto; /* CENTERS THE CARD IN THE MIDDLE OF THE WINDOW */\n    word-wrap: break-word; /* BREAKS UP LONG WORKS */\n}\n\n\n.replay-button { text-decoration: none; display: inline-flex; vertical-align: middle; margin: 3px; }\n\n\n.replay-button svg circle { fill: #3f3f3f; stroke: #202020; }\n\n.replay-button svg path { fill: #ab997e; }\n\n.mobile .replay-button svg { width: 50px; height: 50px; }\n.replay-button svg { width: 50px; height: 50px; }\n\nsvg > text { fill: #ab997e !important; }\nsvg > path { stroke: #b29584 !important; }\nsvg > circle[r=\"5\"] { fill: #ab997e !important; }\nsvg > circle[r=\"3.25\"] { fill: #2d2d2d !important; }",
  "deck_name": "Core 2k_6k [ Pitch Graphs, Optimized, Links ]"
}